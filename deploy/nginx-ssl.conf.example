# 放在 /etc/nginx/conf.d/blog.conf（由 http {} include）中。
limit_req_zone $binary_remote_addr zone=blog_auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=blog_events:10m rate=30r/m;
server {
  listen 80;
  server_name kongqi.xyz;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}
server {
  listen 443 ssl http2;
  server_name kongqi.xyz;
  ssl_certificate /etc/letsencrypt/live/kongqi.xyz/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/kongqi.xyz/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  location /api/auth/ {
    limit_req zone=blog_auth burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    add_header Cache-Control "no-store" always;
  }
  location = /api/analytics/events {
    limit_req zone=blog_events burst=10 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:8080;
    client_max_body_size 8k;
    add_header Cache-Control "no-store" always;
  }
  location / { proxy_pass http://127.0.0.1:8080; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }
  client_max_body_size 20m;
}
