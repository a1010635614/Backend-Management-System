FROM python:3.12-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash util-linux \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /checks
COPY test-native-release.py test_native_release.py release-native.sh ./
COPY test_native_artifact.py stage_native_artifact.py ./
COPY test_native_package.py package_native.py ./
COPY test_native_flow.py build-flow.sh ./
RUN python test-native-release.py
RUN mkdir -p /workspace/backend /workspace/frontend/dist /workspace/deploy
WORKDIR /workspace
CMD ["python", "/checks/package_native.py"]
