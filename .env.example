# Local Compose example. Generate new random credentials for a real deployment.
APP_ENV=development
RELEASE_TAG=local
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=ReplaceThisDatabasePassword1234567890
DATABASE_URL=postgresql+asyncpg://blog:ReplaceThisDatabasePassword1234567890@postgres:5432/blog
REDIS_PASSWORD=ReplaceThisRedisPassword1234567890123
REDIS_URL=redis://:ReplaceThisRedisPassword1234567890123@redis:6379/0
JWT_SECRET=development-only-change-this-secret-key
ADMIN_EMAILS=admin@example.com
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
GATEWAY_PORT=8080
BACKEND_PORT=8000
AUTH_CAPTCHA_REQUIRED=true
GEETEST_ID=
GEETEST_KEY=
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
COS_REGION=ap-shanghai
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
CDN_BASE_URL=
CDN_AUTH_KEY=
BAIDU_HM_ID=

# Optional: use Flow notification plugin OR this script, to avoid duplicate notices.
FEISHU_WEBHOOK=
FEISHU_SIGNING_SECRET=
SITE_URL=http://127.0.0.1:8080
